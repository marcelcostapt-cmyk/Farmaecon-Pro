# Read these from the existing Traefik configuration; do not guess.
TRAEFIK_NETWORK=
TRAEFIK_CERT_RESOLVER=
MARKETPLACE_SOURCE=MOCK
ML_PKCE_ENABLED=false
ML_APP_ID=
