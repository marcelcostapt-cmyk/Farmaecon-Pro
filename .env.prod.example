# Reference only. Run npm run prod:init to generate new secrets in .local/production.env.
# Never replace keys/passwords of an existing deployment with a new initialization.
DB_USER=farmaecon
DB_PASSWORD=
DB_NAME=farmaecon_db
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
TOKEN_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY=
